# ===== 基础 =====
# 服务监听端口
PORT=3000
# 监听地址，默认不填（监听所有网卡）；本地验证时可设为 127.0.0.1
HOST=
# 外部可访问的基础地址（OAuth 回调依赖它，例如 http://192.168.1.10:3000）
APP_URL=http://localhost:3000
# 前端独立部署/开发时的地址（生产同源部署可留空）
FRONTEND_ORIGIN=http://localhost:5173
# JWT 签名与敏感数据加密密钥，务必改为随机长字符串
APP_SECRET=change-me-to-a-long-random-string
# 运行时数据目录（SQLite、附件）
DATA_DIR=./data

# ===== 登录（单用户） =====
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# 登录态有效期（小时）
JWT_TTL_HOURS=168

# ===== 免登录分享 =====
# 分享链接签名密钥。留空则回退用 APP_SECRET 派生（独立 salt，与会话密钥不互通）。
# 建议单独生成一个强随机值，并在需要让旧分享链接全部失效时直接轮换它：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_SECRET=
# 分享链接有效期（小时），0 表示永不过期
SHARE_TTL_HOURS=168

# ===== 同步 =====
# 全局默认同步间隔（秒），可在界面按邮箱覆盖
SYNC_INTERVAL_SEC=300
# 首次回填每个文件夹的最新邮件数
SYNC_BACKFILL_COUNT=50
# 启动 30 秒后是否立即执行一轮同步（1 开 0 关）
SYNC_ON_START=1

# ===== 钉钉推送（仅在界面按邮箱开关与配置关键词） =====
# 填写 DINGTALK_WEBHOOK_URL 即视为启用推送；留空则关闭
DINGTALK_WEBHOOK_URL=
# 加签密钥，机器人安全设置为"加签"时必填
DINGTALK_SECRET=
# 只推送该小时数内的新邮件（防止首次回填轰炸）
PUSH_MAX_AGE_HOURS=48
# 推送中的「阅读邮件」链接基于 APP_URL 生成分享链接，请把 APP_URL 配成外部可访问地址

# ===== Gmail OAuth2 =====
# Google Cloud Console 创建 OAuth 客户端（Web 应用）
# scope 需要 https://mail.google.com/ ；回调地址: {APP_URL}/api/mailboxes/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Outlook / Microsoft 365 OAuth2 =====
# Azure 应用注册（个人+组织账户均可），API 权限:
#   offline_access / IMAP.AccessAsUser.All / SMTP.Send / User.Read
# 回调地址: {APP_URL}/api/mailboxes/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 个人账户用 consumers，组织用租户 ID，两类都支持用 common
MICROSOFT_TENANT=common

# ===== OIDC 登录（自有单点登录） =====
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 默认 {APP_URL}/api/auth/oidc/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# 可选：只允许该邮箱登录
OIDC_ALLOWED_EMAIL=
# issuer 为 http:// 时必须设 1
OIDC_INSECURE=0
